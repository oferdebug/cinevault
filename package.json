		"lint": "pnpm -r lint"
	},
	"engines": {
		"node": ">=20",
		"pnpm": ">=10"
	},
	"packageManager": "pnpm@10.33.2",
	"devDependencies": {
		"@biomejs/biome": "2.4.15",
		"@types/node": "^25.6.2",
		"typescript": "^6.0.3"
	}
}
