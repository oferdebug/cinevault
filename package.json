{
	"name": "cinevault",
	"version": "0.0.0",
	"private": true,
	"description": "CineVault monorepo — web, api, worker",
	"scripts": {
		"dev:web": "pnpm --filter web dev",
		"dev:api": "pnpm --filter api dev",
		"dev:worker": "pnpm --filter worker dev",
