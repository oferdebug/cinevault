# CineVault — copy this to `.env` and fill in real values

# API server
PORT=4000
NODE_ENV=development
LOG_LEVEL=info

# Web app (Vite only exposes VITE_ prefixed vars to browser)
VITE_API_URL=http://localhost:4000

# Database — dev-only credentials with embedded user:password; never commit real production credentials
DATABASE_URL=postgresql://cinevault:cinevault_dev_pw@localhost:5432/cinevault

# Redis
REDIS_URL=redis://localhost:6379

# Auth — generate with: openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d

# Object storage (MinIO in dev / S3 in prod)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=cinevault
S3_SECRET_KEY=cinevault_dev_pw
S3_BUCKET=videos
S3_FORCE_PATH_STYLE=true

# External APIs — get keys at:
# TMDB: https://www.themoviedb.org/settings/api
# OMDB: http://www.omdbapi.com/apikey.aspx
TMDB_API_KEY=
OMDB_API_KEY=


# Clerk
VITE_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=